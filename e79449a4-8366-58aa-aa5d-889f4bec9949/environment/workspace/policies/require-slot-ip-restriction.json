{
  "if": {
    "allOf": [
      {
        "field": "type",
        "equals": "Microsoft.Web/sites/config"
      },
      {
        "field": "id",
        "like": "*/sites/func-paymesh-pagos-prod/slots/blue/config/web"
      },
      {
        "not": {
          "field": "Microsoft.Web/sites/config/web.ipSecurityRestrictionsDefaultAction",
          "equals": "Deny"
        }
      }
    ]
  },
  "then": {
    "effect": "Audit"
  }
}
