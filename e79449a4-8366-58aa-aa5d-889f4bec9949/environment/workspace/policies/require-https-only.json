{
  "if": {
    "allOf": [
      {
        "field": "type",
        "equals": "Microsoft.Web/sites"
      },
      {
        "field": "name",
        "like": "*-${environment}"
      },
      {
        "not": {
          "field": "Microsoft.Web/sites/httpsOnly",
          "equals": "true"
        }
      }
    ]
  },
  "then": {
    "effect": "Deny"
  }
}
