#!/bin/bash
# run-release drives the five stage release through relx. The engine threads an
# accumulating ledger; this driver decides which ledger each stage is handed.
# The rostering desk left this driver as it stood after the promote isolation
# change went in during the incident window.
set -uo pipefail

STATE=/workspace/state
LEDGER="$STATE/ledger.json"
mkdir -p "$STATE"

# Every release opens on a clean ledger so a re-run does not stack onto the last.
: > "$LEDGER"

relx stage compile  --ledger "$LEDGER"
relx stage migrate  --ledger "$LEDGER"
relx stage canary   --ledger "$LEDGER"

# Promote is run against an isolated ledger so a promotion that is rolled back
# cannot leave half written canary artifacts on the release of record. The
# isolated ledger is seeded from the tip of the accumulated one and copied back
# once promote returns clean.
PROMOTE="$STATE/promote.json"
relx snapshot --ledger "$LEDGER" --into "$PROMOTE" --last 1
relx stage promote --ledger "$PROMOTE"
cp "$PROMOTE" "$LEDGER"

relx stage finalize --ledger "$LEDGER"

relx manifest --ledger "$LEDGER" > "$STATE/manifest.json"
echo "release driver complete"
