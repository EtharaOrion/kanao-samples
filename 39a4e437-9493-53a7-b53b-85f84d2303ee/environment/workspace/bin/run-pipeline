#!/usr/bin/env bash
set -uo pipefail

STATE=/workspace/state
CARRY="$STATE/carry.json"
STAGE="$STATE/stage.json"

mkdir -p "$STATE"
: > "$CARRY"
rm -f "$CARRY.journal" "$STAGE" "$STAGE.journal"

cicd phase lint --carry "$CARRY"
cicd phase build --carry "$CARRY"
cicd phase test --carry "$CARRY"

# During an incident window the package phase was isolated onto its own carry so
# a flaky publisher could not see the earlier phases. The isolation folds the
# accumulated carry down to the test tip before packaging and then copies the
# isolated carry back over the pipeline carry.
cicd fold --carry "$CARRY" --into "$STAGE" --keep 1
cicd phase package --carry "$STAGE"
cp "$STAGE" "$CARRY"

cicd phase publish --carry "$CARRY"

cicd report --carry "$CARRY" > "$STATE/report.json"
