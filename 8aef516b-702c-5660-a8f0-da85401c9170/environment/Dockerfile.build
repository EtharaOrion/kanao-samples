FROM python:3.12-slim AS base
ENV DEBIAN_FRONTEND=noninteractive PYTHONDONTWRITEBYTECODE=1
RUN apt-get update && apt-get install -y --no-install-recommends bash curl jq procps lsof less nano vim-tiny tmux asciinema && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir pytest==8.4.1
WORKDIR /app
FROM base AS workstation
COPY doc/ /app/doc/
ENTRYPOINT ["bash", "-c", "sleep infinity"]
FROM base AS runtime
COPY svc/ /opt/svc/
RUN mkdir -p /opt/estate \
    && echo "" | base64 -d > /opt/estate/scenario.json \
    && echo "c74956feb7446c9f91dffcba100c68d5ad648dbc96bde12ca0aeda736f7078e1" > /opt/estate/receipt.key \
    && chmod +x /opt/svc/start.sh /opt/svc/workload.sh \
    && python3 -m compileall -b -x recorder /opt/svc \
    && rm /opt/svc/service.py
ENTRYPOINT ["/opt/svc/start.sh"]
